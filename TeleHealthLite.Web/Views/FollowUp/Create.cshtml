
@model TeleHealthLite.Web.Models.FollowUp

@{
    ViewData["Title"] = "Add Follow-up";
}

<div class="container mt-4">
    <h2>Add Follow-up Reminder</h2>
    <p class="text-muted">Schedule a reminder for a patient.</p>
    <hr />

    <form asp-controller="FollowUp" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="PatientId" class="form-label">Patient</label>
            <select asp-for="PatientId"
                    asp-items="ViewBag.Patients"
                    class="form-select"
                    required>
                <option value="">-- Select Patient --</option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReminderDate" class="form-label">Reminder Date and Time</label>
            <input asp-for="ReminderDate"
                   type="datetime-local"
                   class="form-control"
                   required />
            <span asp-validation-for="ReminderDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"
                      maxlength="300"
                      placeholder="Enter follow-up details"
                      required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Reminder</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
